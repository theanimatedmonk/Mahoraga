# Figma REST API credentials
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get a token: https://www.figma.com/developers/api#access-tokens
# Team ID: open the team in Figma → URL looks like
#   https://www.figma.com/files/team/1234567890/...
#   → FIGMA_TEAM_ID=1234567890

FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=
